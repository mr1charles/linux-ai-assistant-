# Copy this file to .env and fill in what you use. Nothing here is required —
# Little Toby works fully offline without any of these set. They only matter
# for the specific features that need them (Discord sends, email checks).

# Local LLM (defaults are fine if you followed the install script)
OLLAMA_URL=http://localhost:11434/api/chat
# Leave blank to use the best model you have installed (see model_picker.py).
OLLAMA_MODEL=

# Voice assistant mode only (linux_agent_assistant.py)
WAKE_WORD=toby

# Discord — only used when you ask it to send a message
DISCORD_WEBHOOK_URL=

# Email — only used when you ask it to check email
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
IMAP_SERVER=imap.gmail.com
