[Unit]
Description=Little Toby desktop assistant
Documentation=file://@REPO@/README.md
After=graphical-session.target
PartOf=graphical-session.target
# a crash loop shouldn't spin forever
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
ExecStart=@REPO@/scripts/toby-session.sh linux_agent_apple.py
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target default.target
