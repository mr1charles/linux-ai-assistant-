[Unit]
Description=Little Toby lid fold animation
Documentation=file://@REPO@/scripts/toby_fold.py
After=graphical-session.target
PartOf=graphical-session.target
# a crash loop shouldn't spin forever
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
ExecStart=@REPO@/scripts/toby-session.sh toby_fold.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target default.target
