.env
vosk-model-small-en-us-0.15/
__pycache__/
*.pyc

# Personal data Toby generates at runtime — never belongs in a public repo
history.json
knowledge.json
study_notes.json
school_mode.json
settings.json
camera_gestures.json
session_log.md
knowledge_tree.png
knowledge_bubbles.png

# Downloaded model files (large, and install.sh fetches them automatically)
hand_landmarker.task
face_landmarker.task

# Study plan data (generated at runtime, personal)
study_plan.json

# What you've asked Toby to do (task history, personal)
tasks.json
tasks.tmp

# The phone pairing token — a live credential; never commit it
remote.json
remote.tmp

# The Telegram bot's token and Toby's token for it — live credentials
telegram.json
telegram.tmp

# The search index of your notes: passages of your own notes, personal
notes_index.sqlite
notes_index.sqlite-*

# Toby's private Python environment (install.sh creates it)
.venv/

# iPhone app build output (the Xcode project is generated from ios/project.yml)
ios/build/
ios/Payload/
ios/*.ipa
ios/*.zip
ios/LittleToby.xcodeproj/

# backups the installer makes when updating over changed files
.before-update-*/
